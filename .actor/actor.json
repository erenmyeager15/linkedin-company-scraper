{
    "actorSpecification": 1,
    "name": "linkedin-company-scraper",
    "title": "LinkedIn Company Monitor - CRM & Headcount Changes",
    "description": "Enrich public LinkedIn company pages and monitor follower, employee, website, industry, size, HQ, and company-type changes. Includes private history, deterministic signals, Markdown/CSV reports, and direct-first cost control.",
    "version": "1.1",
    "dockerfile": "Dockerfile",
    "readme": "../README.md",
    "input": "../INPUT_SCHEMA.json",
    "output": "./output_schema.json",
    "exampleRunInput": {
        "contentType": "application/json; charset=utf-8",
        "body": "{\"companyUrls\":[\"https://www.linkedin.com/company/microsoft\",\"https://www.linkedin.com/company/apifytech\"],\"companyNames\":[],\"maxResults\":5,\"accessMode\":\"direct_first\",\"watchlistName\":\"us-saas-watchlist\",\"followerChangePercent\":5,\"employeeChangePercent\":5,\"historyLimit\":10,\"generateMarkdownReport\":true,\"generateCsvReport\":true,\"proxyConfiguration\":{\"useApifyProxy\":true,\"apifyProxyGroups\":[\"RESIDENTIAL\"],\"apifyProxyCountry\":\"US\"}}"
    },
    "pricingInfo": {
        "pricingModel": "PAY_PER_EVENT",
        "pricingPerEvent": {
            "actorChargeEvents": {
                "company-scraped": {
                    "eventTitle": "Company scraped",
                    "eventDescription": "Charged once for each LinkedIn company profile successfully scraped.",
                    "eventPriceUsd": 0.003,
                    "isPrimaryEvent": true,
                    "isOneTimeEvent": false
                }
            }
        }
    },
    "categories": ["LEAD_GENERATION", "SOCIAL_MEDIA", "AUTOMATION"],
    "minMemoryMbytes": 1024,
    "maxMemoryMbytes": 4096,
    "defaultRunOptions": {
        "memoryMbytes": 1024,
        "timeoutSecs": 43200
    },
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "views": {
                "companies": {
                    "title": "Scraped Companies",
                    "transformation": {
                        "fields": [
                            "companyName",
                            "linkedinUrl",
                            "website",
                            "websiteDomain",
                            "companyDescription",
                            "industry",
                            "companySize",
                            "headquartersLocation",
                            "companyType",
                            "foundedYear",
                            "specialties",
                            "followerCount",
                            "employeeCount",
                            "followerCountNumeric",
                            "employeeCountNumeric",
                            "fieldCoveragePercent",
                            "watchlistName",
                            "observationStatus",
                            "observationCount",
                            "deltas",
                            "changes",
                            "signals",
                            "logoUrl",
                            "matchedFromName",
                            "scrapedAt"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "companyName": { "label": "Company Name", "format": "text" },
                            "linkedinUrl": { "label": "LinkedIn URL", "format": "link" },
                            "website": { "label": "Website", "format": "link" },
                            "websiteDomain": { "label": "Website Domain", "format": "text" },
                            "companyDescription": { "label": "Company Description", "format": "text" },
                            "industry": { "label": "Industry", "format": "text" },
                            "companySize": { "label": "Size", "format": "text" },
                            "headquartersLocation": { "label": "HQ", "format": "text" },
                            "companyType": { "label": "Company Type", "format": "text" },
                            "foundedYear": { "label": "Founded", "format": "number" },
                            "specialties": { "label": "Specialties", "format": "array" },
                            "followerCount": { "label": "Followers", "format": "text" },
                            "employeeCount": { "label": "Employee Count", "format": "text" },
                            "followerCountNumeric": { "label": "Followers (Numeric)", "format": "number" },
                            "employeeCountNumeric": { "label": "Employees (Numeric)", "format": "number" },
                            "fieldCoveragePercent": { "label": "Field Coverage %", "format": "number" },
                            "watchlistName": { "label": "Watchlist", "format": "text" },
                            "observationStatus": { "label": "Observation Status", "format": "text" },
                            "observationCount": { "label": "Observation Count", "format": "number" },
                            "deltas": { "label": "Count Deltas", "format": "object" },
                            "changes": { "label": "Changed Fields", "format": "array" },
                            "signals": { "label": "Signals", "format": "array" },
                            "logoUrl": { "label": "Logo URL", "format": "image" },
                            "matchedFromName": { "label": "Matched From Name", "format": "text" },
                            "scrapedAt": { "label": "Scraped At", "format": "date" }
                        }
                    }
                }
            }
        }
    }
}
